# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database & Cache
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/nayantara_opticals?schema=public
REDIS_URL=redis://localhost:6379

# JWT Secrets (Generate with `openssl rand -base64 48`)
JWT_ACCESS_SECRET=nayantara_development_access_jwt_secret_key_2026
JWT_REFRESH_SECRET=nayantara_development_refresh_jwt_secret_key_2026

# Default Super Admin Seed Credentials
SUPER_ADMIN_EMAIL=admin@nayantaraopticals.com
SUPER_ADMIN_PASSWORD=Admin@Nayantara2026!
SUPER_ADMIN_PHONE=+919876543210

# AWS S3 / Cloudflare R2 (Private Encrypted Bucket for Prescriptions)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=nayantara-prescriptions-private
AWS_ENDPOINT=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=webhook_secret_placeholder

# Transactional Notifications
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=no-reply@nayantaraopticals.com

SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=

WHATSAPP_PROVIDER=meta
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
